# Entry point
# --------------------------------------------------------------------------

def run_tui(storage, cfg, cfg_warning, files, stdin_text):
    os.environ.setdefault("ESCDELAY", "25")
    cwd = os.getcwd()
    app = None
    scr = curses.initscr()

    def on_signal(signum, frame):
        if app is not None:
            app.stop_signal = True
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, on_signal)

    try:
        curses.noecho()
        curses.raw()
        scr.keypad(True)
        if hasattr(curses, "set_escdelay"):
            curses.set_escdelay(25)
        try:
            curses.start_color()
            curses.use_default_colors()
        except curses.error:
            pass
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        curses.mouseinterval(0)
        os.write(sys.stdout.fileno(), b"\x1b[?2004h\x1b[?1002h")   # bracketed paste, drag reporting
        app = App(scr, storage, cfg, cfg_warning, files, stdin_text, cwd)
        app.loop()
    finally:
        if app is not None:
            app.shutdown()
        try:
            os.write(sys.stdout.fileno(), b"\x1b[?1002l\x1b[?2004l")
        except OSError:
            pass
        try:
            curses.endwin()
        except curses.error:
            pass


HELP_EPILOG = """
Notes ("Untitled" tabs) are saved automatically, 2s after you stop typing.
Opened files are saved with Ctrl+S; unsaved edits to them survive quitting.
Press F1 inside the app for every key. Keys can be rebound in
%s, e.g.  "keys": {"next_tab": ["alt+right", "ctrl+pgdn"]}
""" % shorten_home(CONFIG_PATH)


def main(argv=None):
    locale.setlocale(locale.LC_ALL, "")
    ap = argparse.ArgumentParser(prog=APP, description="A persistent, tabbed notepad for the terminal "
                                 "(modeled on DankMaterialShell's notepad).", epilog=HELP_EPILOG,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="*", help="files to open in tabs ('-' reads stdin into a new note)")
    ap.add_argument("--dir", help="storage directory (default: %s)" % shorten_home(DEFAULT_DIR))
    ap.add_argument("--dms", action="store_true", help="share DankMaterialShell's notepad storage (%s)" % shorten_home(DMS_DIR))
    ap.add_argument("--new", metavar="TEXT", help="add a note with TEXT ('-' = stdin) and exit; a running instance picks it up")
    ap.add_argument("--list", action="store_true", help="list tabs and exit")
    ap.add_argument("--version", action="version", version="%s %s" % (APP, VERSION))
    args = ap.parse_args(argv)

    cfg, cfg_warning = load_config()
    base = os.path.abspath(os.path.expanduser(args.dir or os.environ.get("TUINOTEPAD_DIR") or
                                              (DMS_DIR if args.dms else DEFAULT_DIR)))
    storage = Storage(base)

    if args.list:
        res = storage.load_meta()
        for i, t in enumerate(res[0] if res else []):
            mark = "*" if res and i == res[1] else " "
            kind = "note" if t.get("isTemporary") else "file"
            print("%s %2d  %-30s %s  %s" % (mark, i + 1, t.get("title", UNTITLED), kind, shorten_home(storage.full_path(t))))
        return 0

    if args.new is not None:
        text = sys.stdin.read() if args.new == "-" else args.new
        res = storage.load_meta()
        tabs, idx = res if res else ([], 0)
        tab = storage.make_note_tab()
        atomic_write(storage.full_path(tab), text)
        tabs.append(tab)
        storage.save_meta(tabs, idx)
        print("Added note to %s" % shorten_home(storage.base))
        return 0

    stdin_text = None
    files = [f for f in args.files if f != "-"]
    if "-" in args.files or not sys.stdin.isatty():
        if not sys.stdin.isatty():
            stdin_text = sys.stdin.read().replace("\r\n", "\n")
            try:
                fd = os.open("/dev/tty", os.O_RDWR)
                os.dup2(fd, 0)
                os.close(fd)
            except OSError:
                print("%s: no terminal available" % APP, file=sys.stderr)
                return 1
    if not sys.stdout.isatty():
        print("%s: stdout is not a terminal" % APP, file=sys.stderr)
        return 1
    try:
        run_tui(storage, cfg, cfg_warning, files, stdin_text)
    except Exception:
        log_exception()
        traceback.print_exc()
        print("\n%s crashed; your notes were saved. Details: %s" % (APP, shorten_home(LOG_PATH)), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
