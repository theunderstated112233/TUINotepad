# --------------------------------------------------------------------------

def _mods_from_xterm(m):
    m = max(0, m - 1)
    mods = []
    if m & 4:
        mods.append("ctrl")
    if m & 2:
        mods.append("alt")
    if m & 1:
        mods.append("shift")
    return mods


def with_mods(mods, base):
    s = set(mods)
    return "+".join([m for m in MOD_ORDER if m in s] + [base])


CSI_FINAL = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end",
             "P": "f1", "Q": "f2", "R": "f3", "S": "f4"}
CSI_TILDE = {1: "home", 2: "insert", 3: "delete", 4: "end", 5: "pgup", 6: "pgdn", 7: "home", 8: "end",
             11: "f1", 12: "f2", 13: "f3", 14: "f4", 15: "f5", 17: "f6", 18: "f7", 19: "f8", 20: "f9",
             21: "f10", 23: "f11", 24: "f12"}
TERMINFO_BASE = {"LFT": "left", "RIT": "right", "UP": "up", "DN": "down", "NXT": "pgdn", "PRV": "pgup",
                 "HOM": "home", "END": "end", "DC": "delete", "IC": "insert"}


def parse_csi(seq):
    m = re.fullmatch(r"[\[O](\d*)(?:;(\d+))?([A-DFHPQRS~])", seq)
    if not m:
        return None
    num, mod, final = m.group(1), m.group(2), m.group(3)
    if final == "~":
        base = CSI_TILDE.get(int(num or 0))
    else:
        base = CSI_FINAL.get(final)
    if not base:
        return None
    return with_mods(_mods_from_xterm(int(mod)) if mod else [], base)


class Input:
    def __init__(self, scr):
        self.scr = scr
        self.pending = []
        k = curses
        self.intmap = {
            k.KEY_UP: "up", k.KEY_DOWN: "down", k.KEY_LEFT: "left", k.KEY_RIGHT: "right",
            k.KEY_HOME: "home", k.KEY_END: "end", k.KEY_PPAGE: "pgup", k.KEY_NPAGE: "pgdn",
            k.KEY_DC: "delete", k.KEY_IC: "insert", k.KEY_BACKSPACE: "backspace", k.KEY_ENTER: "enter",
            k.KEY_BTAB: "shift+tab", k.KEY_SLEFT: "shift+left", k.KEY_SRIGHT: "shift+right",
            k.KEY_SR: "shift+up", k.KEY_SF: "shift+down", k.KEY_SHOME: "shift+home", k.KEY_SEND: "shift+end",
            k.KEY_SPREVIOUS: "shift+pgup", k.KEY_SNEXT: "shift+pgdn", k.KEY_SDC: "shift+delete",
            getattr(k, "KEY_B2", -99): "", getattr(k, "KEY_A1", -98): "home", getattr(k, "KEY_C1", -97): "end",
            getattr(k, "KEY_A3", -96): "pgup", getattr(k, "KEY_C3", -95): "pgdn",
        }
        for n in range(1, 61):
            base = "f%d" % ((n - 1) % 12 + 1)
            mods = [[], ["shift"], ["ctrl"], ["ctrl", "shift"], ["alt"]][(n - 1) // 12]
            self.intmap[curses.KEY_F0 + n] = with_mods(mods, base)

    def _get(self, timeout):
        if self.pending:
            return self.pending.pop(0)
        self.scr.timeout(timeout)
        try:
            return self.scr.get_wch()
        except curses.error:
            return None
        except KeyboardInterrupt:
            return "\x03"

    def read(self, timeout):
        events = []
        ch = self._get(timeout)
        while ch is not None:
            ev = self._decode(ch)
            if ev:
                events.append(ev)
            if len(events) >= 4000:
                break
            ch = self._get(0)
        return events

    def _intname(self, code):
        if code in self.intmap:
            return self.intmap[code]
        try:
            kn = curses.keyname(code).decode()
        except (ValueError, curses.error):
            return None
        m = re.fullmatch(r"k(LFT|RIT|UP|DN|NXT|PRV|HOM|END|DC|IC)(\d)", kn)
        if m:
            return with_mods(_mods_from_xterm(int(m.group(2))), TERMINFO_BASE[m.group(1)])
        return None

    @staticmethod
    def _charname(ch):
        o = ord(ch)
        if o == 0:
            return "ctrl+space"
        if o in (10, 13):
            return "enter"
        if o == 9:
            return "tab"
        if o in (8, 127):
            return "backspace"
        if 1 <= o <= 26:
            return "ctrl+" + chr(o + 96)
        if 28 <= o <= 31:
            return "ctrl+" + "\\]^_"[o - 28]
        return None

    def _decode(self, ch):
        if isinstance(ch, int):
            if ch == curses.KEY_RESIZE:
                return ("resize",)
            if ch == curses.KEY_MOUSE:
                try:
                    _, x, y, _, b = curses.getmouse()
                    return ("mouse", x, y, b)
                except curses.error:
                    return None
            name = self._intname(ch)
            return ("key", name) if name else None
        if ch == "\x1b":
            return self._escape()
        name = self._charname(ch)
        if name:
            return ("key", name)
        return ("char", ch)

    def _escape(self):
        ch = self._get(30)
        if ch is None:
            return ("key", "esc")
        if isinstance(ch, int):
            name = self._intname(ch)
            return ("key", with_mods(["alt"] + name.split("+")[:-1], name.split("+")[-1])) if name else None
        if ch == "\x1b":
            inner = self._escape()
            if inner and inner[0] == "key" and inner[1] != "esc":
                parts = inner[1].split("+")
                return ("key", with_mods(["alt"] + parts[:-1], parts[-1]))
            return ("key", "esc")
        if ch in "[O":
            seq = ch
            while True:
                c = self._get(30)
                if c is None:
                    break
                if isinstance(c, int):
                    self.pending.append(c)
                    break
                seq += c
                if "\x40" <= c <= "\x7e" or len(seq) > 32:
                    break
            if seq in ("[", "O"):
                return ("key", "alt+shift+o" if seq == "O" else "alt+[")
            if seq == "[200~":
                return ("paste", self._read_paste())
            name = parse_csi(seq)
            return ("key", name) if name else None
        name = self._charname(ch)
        if name:
            parts = name.split("+")
            return ("key", with_mods(["alt"] + parts[:-1], parts[-1]))
        if ch.isalpha() and ch.isupper():
            return ("key", "alt+shift+" + ch.lower())
        return ("key", "alt+" + ch)

    def _read_paste(self):
        buf = []
        end = "\x1b[201~"
        while True:
            c = self._get(200)
            if c is None:
                break
            if isinstance(c, int):
                name = self._intname(c)
                if name == "enter":
                    buf.append("\n")
                continue
            buf.append(c)
            if c == "~" and "".join(buf[-6:]) == end:
                del buf[-6:]
                break
        return "".join(buf).replace("\r\n", "\n").replace("\r", "\n")


class LineInput:
    """Single-line text field used by prompts and the find bar."""

    def __init__(self, text=""):
        self.text = text
        self.pos = len(text)

    def handle(self, ev):
        kind = ev[0]
        if kind == "char":
            self.text = self.text[:self.pos] + ev[1] + self.text[self.pos:]
            self.pos += len(ev[1])
            return "edit"
        if kind == "paste":
            t = ev[1].replace("\n", " ")
            self.text = self.text[:self.pos] + t + self.text[self.pos:]
            self.pos += len(t)
            return "edit"
        if kind != "key":
            return None
        k = ev[1]
        if k == "enter":
            return "enter"
        if k == "esc":
            return "cancel"
        if k == "backspace" and self.pos > 0:
            self.text = self.text[:self.pos - 1] + self.text[self.pos:]
            self.pos -= 1
            return "edit"
        if k in ("alt+backspace", "ctrl+w"):
            i = self.pos
            while i > 0 and not is_word(self.text[i - 1]):
                i -= 1
            while i > 0 and is_word(self.text[i - 1]):
                i -= 1
            self.text = self.text[:i] + self.text[self.pos:]
            self.pos = i
            return "edit"
        if k == "delete" and self.pos < len(self.text):
            self.text = self.text[:self.pos] + self.text[self.pos + 1:]
            return "edit"
        if k == "ctrl+u":
            self.text, self.pos = "", 0
            return "edit"
        if k == "left":
            self.pos = max(0, self.pos - 1)
        elif k == "right":
            self.pos = min(len(self.text), self.pos + 1)
        elif k in ("home", "ctrl+a"):
            self.pos = 0
        elif k in ("end", "ctrl+e"):
            self.pos = len(self.text)
        else:
            return None
        return "move"


