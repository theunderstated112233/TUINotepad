def pretty_key(k):
    names = {"ctrl": "Ctrl", "alt": "Alt", "shift": "Shift", "pgdn": "PgDn", "pgup": "PgUp", "left": "←",
             "right": "→", "up": "↑", "down": "↓", "space": "Space", "esc": "Esc", "enter": "Enter",
             "tab": "Tab", "backspace": "Backspace", "delete": "Del", "home": "Home", "end": "End"}
    return "+".join(names.get(p, p.upper()) for p in k.split("+"))


