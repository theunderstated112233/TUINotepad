        mono = {"sel": curses.A_REVERSE, "match": curses.A_UNDERLINE | curses.A_BOLD, "bar": curses.A_REVERSE,
                "bar_dim": curses.A_REVERSE, "bar_primary": curses.A_REVERSE | curses.A_BOLD, "tab": curses.A_REVERSE,
