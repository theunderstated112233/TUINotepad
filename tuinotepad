def normalize_keyname(name):
    parts = [p for p in name.strip().lower().replace(" ", "").split("+") if p]
    if not parts:
        return ""
    if parts[-1] == "" and len(parts) > 1:
        parts[-1] = "+"
    base = KEY_ALIASES.get(parts[-1], parts[-1])
    mods = [m for m in MOD_ORDER if m in parts[:-1]]
    return "+".join(mods + [base])


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    warning = None
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            user = json.load(f)
        if isinstance(user, dict):
            for k, v in user.items():
                if k in cfg:
                    cfg[k] = v
    except FileNotFoundError:
        save_config(cfg)
    except (OSError, ValueError) as e:
        warning = "config.json ignored: %s" % e
    return cfg, warning


def save_config(cfg):
    try:
        atomic_write(CONFIG_PATH, json.dumps(cfg, indent=2) + "\n")
    except OSError:
        pass


def build_keymap(cfg):
    actions = {a: list(keys) for a, keys, _ in ACTIONS}
    overrides = cfg.get("keys") or {}
    if isinstance(overrides, dict):
        for act, keys in overrides.items():
            if act in actions:
                actions[act] = [keys] if isinstance(keys, str) else [k for k in keys if isinstance(k, str)]
    keymap = {}
    for act, keys in actions.items():
        for k in keys:
            n = normalize_keyname(k)
            if n:
                keymap[n] = act
    return keymap, actions


