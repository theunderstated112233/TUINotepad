        self.st = storage
        self.cfg = cfg
        self.cwd = cwd
        self.keymap, self.action_keys = build_keymap(cfg)
        self.input = Input(scr)
        self.clip = Clipboard()
        self.tabs = []
        self.cur = 0
        self.docs = {}
        self.closed = []           # stack for "reopen closed tab"
        self.title_cache = {}
        self.wrap_cache = {}
        self.mode = None           # None | "prompt" | "confirm" | "find" | "help"
        self.prompt = None
        self.confirm = None
        self.find = None           # {"input": LineInput, "origin": pos}
        self.matches = []
        self.match_lines = {}
        self.match_key = None
        self.conflict = None       # (tab id, disk text)
        self.msg = None            # (text, level, expires)
        self.show_path = False
        self.help_scroll = 0
        self.follow = True
        self.quit = False
        self.stop_signal = False
        self.last_poll = 0.0
        self.tab_first = 0
        self.regions = []
        self.cursor_screen = None
        self.last_click = (0.0, None, 0)
        self.dragging = False
        self.edit_y0 = 1
        self.edit_h = 1
        self.text_w = 1
        self.gutter = 0
        self.shut_down = False
        self.setup_colors()
        self.load_session()
        for path in open_files:
            self.open_path(path, quiet=True)
        if stdin_text is not None:
            tab = self.st.make_note_tab()
            atomic_write(self.st.full_path(tab), stdin_text)
            self.tabs.append(tab)
            self.cur = len(self.tabs) - 1
            self.save_meta()
        if cfg_warning:
            self.message(cfg_warning, "error")
