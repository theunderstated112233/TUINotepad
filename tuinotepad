# Clipboard
# --------------------------------------------------------------------------

class Clipboard:
    def __init__(self):
        self.internal = ""

    @staticmethod
    def _tools():
        tools = []
        if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
            tools.append((["wl-copy"], ["wl-paste", "-n"]))
        if os.environ.get("DISPLAY"):
            if shutil.which("xclip"):
                tools.append((["xclip", "-selection", "clipboard", "-i"], ["xclip", "-selection", "clipboard", "-o"]))
            if shutil.which("xsel"):
                tools.append((["xsel", "-b", "-i"], ["xsel", "-b", "-o"]))
        if shutil.which("pbcopy"):
            tools.append((["pbcopy"], ["pbpaste"]))
        return tools

    def copy(self, text):
        self.internal = text
        for cp, _ in self._tools():
            try:
                subprocess.run(cp, input=text.encode("utf-8", "surrogateescape"), stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=2, check=True)
                return "clipboard"
            except (OSError, subprocess.SubprocessError):
                continue
        # OSC 52: lets the terminal itself set the clipboard (works over SSH too)
        import base64
        try:
            data = base64.b64encode(text.encode("utf-8", "surrogateescape")).decode()
            os.write(sys.stdout.fileno(), ("\x1b]52;c;%s\x07" % data).encode())
            return "terminal clipboard"
        except OSError:
            return "internal clipboard"

    def paste(self):
        for _, ps in self._tools():
            try:
                out = subprocess.run(ps, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=2, check=True).stdout
                return out.decode("utf-8", "surrogateescape").replace("\r\n", "\n")
            except (OSError, subprocess.SubprocessError):
                continue
        return self.internal


