LOG_PATH = os.path.join(DEFAULT_DIR, "tuinotepad.log")


def log_exception():
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        with open(LOG_PATH, "a", encoding="utf-8") as f:
            f.write("--- %s\n%s\n" % (datetime.now().isoformat(), traceback.format_exc()))
    except OSError:
        pass


