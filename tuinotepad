def load_dms_palette():
    """Wallpaper-derived colors DMS writes via matugen, if this machine runs DMS."""
    try:
        with open(DMS_COLORS, encoding="utf-8") as f:
            data = json.load(f)
        colors = data.get("colors", {})
        scheme = colors.get("light" if data.get("mode") == "light" else "dark") or colors.get("dark")
        pal = dict(PALETTES["purple"])
        for ours, theirs in MATUGEN_KEYS.items():
            v = scheme.get(theirs)
            if isinstance(v, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", v):
                pal[ours] = v
        return pal
    except (OSError, ValueError, AttributeError, TypeError):
        return None


