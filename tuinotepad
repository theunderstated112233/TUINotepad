def atomic_write(path, data):
    path = os.path.realpath(path)
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, ".%s.%d.tmp" % (os.path.basename(path), os.getpid()))
    try:
        with open(tmp, "w", encoding="utf-8", errors="surrogateescape", newline="") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except FileNotFoundError:
            pass
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def read_text(path):
    with open(path, "r", encoding="utf-8", errors="surrogateescape", newline="") as f:
        text = f.read()
    crlf = "\r\n" in text
    if crlf:
        text = text.replace("\r\n", "\n")
    return text, crlf


def file_sig(path):
    try:
        st = os.stat(path)
        return (st.st_mtime_ns, st.st_size, st.st_ino)
    except OSError:
        return None


def iso_now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (int(time.time() * 1000) % 1000)


_last_id = [0]


def new_tab_id():
    # DMS uses Date.now() (ms) as tab ids; keep them unique within a burst.
    tid = max(int(time.time() * 1000), _last_id[0] + 1)
    _last_id[0] = tid
    return tid


def expand_path(p, cwd):
    p = os.path.expandvars(os.path.expanduser(p.strip()))
    return os.path.normpath(p if os.path.isabs(p) else os.path.join(cwd, p))


def shorten_home(p):
    home = os.path.expanduser("~")
    return "~" + p[len(home):] if p == home or p.startswith(home + os.sep) else p


# --------------------------------------------------------------------------
# Storage (DMS-compatible notepad-session.json + notepad-files/)
# --------------------------------------------------------------------------

class Storage:
    def __init__(self, base):
        self.base = base
        self.files_dir = os.path.join(base, "notepad-files")
        self.meta_path = os.path.join(base, "notepad-session.json")
        self.trash_dir = os.path.join(base, "notepad-trash")
        self.recovery_dir = os.path.join(base, "notepad-recovery")
        self.meta_sig = None
        os.makedirs(self.files_dir, exist_ok=True)

    def full_path(self, tab):
        if tab.get("isTemporary"):
            return os.path.join(self.base, tab.get("filePath", ""))
        return tab.get("filePath", "")

    def make_note_tab(self, title=UNTITLED):
        tid = new_tab_id()
        rel = "notepad-files/untitled-%d.txt" % tid
        open(os.path.join(self.base, rel), "a").close()
        return {"id": tid, "title": title, "filePath": rel, "isTemporary": True,
                "lastModified": iso_now(), "cursorPosition": 0, "scrollPosition": 0}

    @staticmethod
    def make_file_tab(path):
        return {"id": new_tab_id(), "title": os.path.basename(path) or path, "filePath": path,
                "isTemporary": False, "lastModified": iso_now(), "cursorPosition": 0, "scrollPosition": 0}

    def load_meta(self):
        sig = file_sig(self.meta_path)
        try:
            with open(self.meta_path, encoding="utf-8") as f:
                data = json.load(f)
        except (OSError, ValueError):
            return None
        self.meta_sig = sig
        tabs = [t for t in data.get("tabs", []) if isinstance(t, dict) and "id" in t and "filePath" in t]
        idx = data.get("currentTabIndex", 0)
        return tabs, idx if isinstance(idx, int) else 0

    def save_meta(self, tabs, idx):
        data = {"version": 1, "currentTabIndex": idx, "tabs": tabs}
        atomic_write(self.meta_path, json.dumps(data, indent=2))
        self.meta_sig = file_sig(self.meta_path)

    def meta_changed(self):
        return file_sig(self.meta_path) != self.meta_sig

    # Unsaved edits to opened files survive quitting/crashes here.
    def _rec_path(self, tid):
        return os.path.join(self.recovery_dir, "%s.json" % tid)

    def save_recovery(self, tab, content, baseline):
        atomic_write(self._rec_path(tab["id"]), json.dumps(
            {"path": tab.get("filePath"), "content": content, "baseline": baseline}))

    def load_recovery(self, tab):
        try:
            with open(self._rec_path(tab["id"]), encoding="utf-8") as f:
                data = json.load(f)
            if data.get("path") == tab.get("filePath"):
                return data["content"], data["baseline"]
        except (OSError, ValueError, KeyError, TypeError):
            pass
        return None

    def clear_recovery(self, tid):
        try:
            os.unlink(self._rec_path(tid))
        except OSError:
            pass

    def trash(self, path):
        os.makedirs(self.trash_dir, exist_ok=True)
        dest = os.path.join(self.trash_dir, os.path.basename(path))
        shutil.move(path, dest)
        return dest

    def purge_trash(self, days=30):
        cutoff = time.time() - days * 86400
        try:
            for name in os.listdir(self.trash_dir):
                p = os.path.join(self.trash_dir, name)
                if os.path.getmtime(p) < cutoff:
                    os.unlink(p)
        except OSError:
            pass


# --------------------------------------------------------------------------
# Text measurement
# --------------------------------------------------------------------------

@lru_cache(maxsize=4096)
def char_width(ch):
    o = ord(ch)
    if o < 32 or o == 127:
        return 2                      # shown as ^X
    if 0xD800 <= o <= 0xDFFF:
        return 1                      # undecodable byte, shown as U+FFFD
    if unicodedata.combining(ch) or unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def text_width(s):
    return sum(char_width(c) for c in s)


def clip(s, maxw, ellipsis="…"):
    if text_width(s) <= maxw:
        return s
    out, w = [], 0
    for c in s:
        cw = char_width(c)
        if w + cw > maxw - 1:
            break
        out.append(c)
        w += cw
    return "".join(out) + ellipsis


def is_word(ch):
    return ch.isalnum() or ch == "_"


# --------------------------------------------------------------------------
# Document: text buffer with undo
# --------------------------------------------------------------------------

def end_of(a, text):
    parts = text.split("\n")
    if len(parts) == 1:
        return (a[0], a[1] + len(text))
    return (a[0] + len(parts) - 1, len(parts[-1]))


class Doc:
    def __init__(self, text, baseline, crlf=False):
        self.lines = text.split("\n")
        self.baseline = baseline
        self.crlf = crlf
        self.cur = (0, 0)
        self.anchor = None
        self.mark = False
        self.want_x = None
        self.top = (0, 0)
        self.undo = []
        self.redo = []
        self.merge_ok = False
        self.version = 0
        self._text = (0, text)
        self.disk_sig = None
        self.last_edit = None          # monotonic time of the last unsaved edit (autosave timer)
        self._group = None

    def text(self):
        if self._text[0] != self.version:
            self._text = (self.version, "\n".join(self.lines))
        return self._text[1]

    def modified(self):
        return self.text() != self.baseline

    def end(self):
        return (len(self.lines) - 1, len(self.lines[-1]))

    def clamp(self, p):
        r = max(0, min(p[0], len(self.lines) - 1))
        return (r, max(0, min(p[1], len(self.lines[r]))))

    def sel(self):
        if self.anchor is None or self.anchor == self.cur:
            return None
        return (min(self.anchor, self.cur), max(self.anchor, self.cur))

    def get(self, a, b):
        (r1, c1), (r2, c2) = a, b
        if r1 == r2:
            return self.lines[r1][c1:c2]
        return "\n".join([self.lines[r1][c1:]] + self.lines[r1 + 1:r2] + [self.lines[r2][:c2]])

    def _raw(self, a, b, text):
        (r1, c1), (r2, c2) = a, b
        new = (self.lines[r1][:c1] + text + self.lines[r2][c2:]).split("\n")
        self.lines[r1:r2 + 1] = new
        self.version += 1
        self.last_edit = time.monotonic()
        return end_of(a, text)

    def begin_group(self):
        self._group = object()

    def end_group(self):
        self._group = None

    def replace(self, a, b, text, kind=None):
        """The one primitive every edit goes through; records undo."""
        if a > b:
            a, b = b, a
        removed = self.get(a, b)
        if not removed and not text:
            return a
        before = self.cur
        end = self._raw(a, b, text)
        rec = self.undo[-1] if self.undo else None
        merged = False
        if kind and self.merge_ok and rec and rec["kind"] == kind and rec["g"] is None and self._group is None:
            if kind == "type" and not removed and a == rec["after"] and "\n" not in text \
                    and not (text.isspace() and rec["ins"] and not rec["ins"][-1].isspace()):
                rec["ins"] += text
                rec["after"] = end
                merged = True
            elif kind == "bs" and not text and b == rec["a"]:
                rec["rem"] = removed + rec["rem"]
                rec["a"] = a
                rec["after"] = a
                merged = True
            elif kind == "del" and not text and a == rec["a"]:
                rec["rem"] += removed
                merged = True
        if not merged:
            self.undo.append({"a": a, "rem": removed, "ins": text, "before": before,
                              "after": end, "kind": kind, "g": self._group})
            if len(self.undo) > 5000:
                del self.undo[:1000]
        self.redo.clear()
        self.cur = end
        self.anchor = None
        self.mark = False
        self.want_x = None
        self.merge_ok = kind is not None
        return end

    def do_undo(self):
        if not self.undo:
            return False
        g = self.undo[-1]["g"]
        while self.undo:
            rec = self.undo.pop()
            self._raw(rec["a"], end_of(rec["a"], rec["ins"]), rec["rem"])
            self.redo.append(rec)
            self.cur = self.clamp(rec["before"])
            if g is None or not self.undo or self.undo[-1]["g"] is not g:
                break
        self.anchor, self.mark, self.merge_ok, self.want_x = None, False, False, None
        return True

    def do_redo(self):
        if not self.redo:
            return False
        g = self.redo[-1]["g"]
        while self.redo:
            rec = self.redo.pop()
            self._raw(rec["a"], end_of(rec["a"], rec["rem"]), rec["ins"])
            self.undo.append(rec)
            self.cur = self.clamp(rec["after"])
            if g is None or not self.redo or self.redo[-1]["g"] is not g:
                break
        self.anchor, self.mark, self.merge_ok, self.want_x = None, False, False, None
        return True

    def set_text_undoable(self, text):
        """Replace everything (e.g. reload from disk) but keep it undoable."""
        cur, top = self.cur, self.top
        self.replace((0, 0), self.end(), text)
        self.cur = self.clamp(cur)
        self.top = (min(top[0], len(self.lines) - 1), 0)

    def offset(self, p=None):
        r, c = p or self.cur
        return sum(len(l) + 1 for l in self.lines[:r]) + c

    def pos_at(self, off):
        for r, line in enumerate(self.lines):
            if off <= len(line):
                return (r, off)
            off -= len(line) + 1
        return self.end()


